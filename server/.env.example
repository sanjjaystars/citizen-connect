# Civic Connect Server Environment Configuration

# Server Port
PORT=5001

# JWT Secret for authentication sessions
JWT_SECRET=civic_connect_super_secret_jwt_key_2025

# Optional: PostgreSQL Database URL with PostGIS extension enabled
# If left empty, the server automatically uses the built-in zero-config spatial SQLite engine
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/civic_connect

# Optional: Google Gemini API Key for LLM classification and conversational chatbot
# If left empty, the server uses its high-accuracy local multilingual NLU engine (English/Tamil/Tanglish)
# GEMINI_API_KEY=your_gemini_api_key_here
